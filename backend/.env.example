# 应用配置
APP_NAME="Server Management System"
APP_VERSION="1.0.0"
DEBUG=True
ENV=development

# 数据库配置
DATABASE_TYPE=postgresql
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/server_agent
# MySQL (取消注释以使用MySQL)
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/server_agent

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis密码（如果没有密码则留空或不设置）
REDIS_PASSWORD=
# Redis数据库编号
REDIS_DB=0
# Celery使用的Redis数据库
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2

# JWT配置
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SSH密钥加密
# IMPORTANT: Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example (DO NOT use this in production - generate your own):
ENCRYPTION_KEY=xQzT-Hn8vYc6MZi2V7fKJ9kL3pN5rS8tA1wD4eG6hB0=

# AI配置
AI_PROVIDER=openai
AI_MODEL=gpt-4
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# CORS配置
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@example.com

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 监控配置
METRICS_COLLECTION_INTERVAL=60  # 秒
METRICS_RETENTION_DAYS=30

# 安全配置
PASSWORD_MIN_LENGTH=8
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_DURATION=600  # 秒
COMMAND_EXECUTION_TIMEOUT=30  # 秒

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
